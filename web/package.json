{
    "name": "robot-status-panel",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vite build",
        "test": "vitest run",
        "test:browser": "node test/manual.browser.cjs && node test/configuration.browser.cjs"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "playwright": "1.64.1",
        "typescript": "~5.9.3",
        "vite": "^7.3.0",
        "vitest": "^3.2.0"
    }
}
