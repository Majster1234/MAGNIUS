<?xml version="1.0"?>
<!-- Model demonstracyjny. Wymiary nie opisują fizycznego robota. Bez ros2_control. -->
<robot name="preview_6dof_demo">
  <material name="body"><color rgba="0.43 0.51 0.57 1"/></material>
  <material name="joint"><color rgba="0.42 0.64 0.56 1"/></material>
  <link name="base_link"><visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.09" length="0.1"/></geometry><material name="body"/></visual></link>
  <link name="link_1"><visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.048" length="0.1"/></geometry><material name="joint"/></visual></link>
  <joint name="joint_1" type="continuous"><parent link="base_link"/><child link="link_1"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/></joint>
  <link name="link_2"><visual><origin xyz="0 0 0.125"/><geometry><box size="0.07 0.07 0.25"/></geometry><material name="body"/></visual></link>
  <joint name="joint_2" type="continuous"><parent link="link_1"/><child link="link_2"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/></joint>
  <link name="link_3"><visual><origin xyz="0.11 0 0"/><geometry><box size="0.22 0.06 0.06"/></geometry><material name="body"/></visual></link>
  <joint name="joint_3" type="continuous"><parent link="link_2"/><child link="link_3"/><origin xyz="0 0 0.25"/><axis xyz="0 1 0"/></joint>
  <link name="link_4"><visual><origin xyz="0.04 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.035" length="0.08"/></geometry><material name="joint"/></visual></link>
  <joint name="joint_4" type="continuous"><parent link="link_3"/><child link="link_4"/><origin xyz="0.22 0 0"/><axis xyz="1 0 0"/></joint>
  <link name="link_5"><visual><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.05 0.05"/></geometry><material name="body"/></visual></link>
  <joint name="joint_5" type="continuous"><parent link="link_4"/><child link="link_5"/><origin xyz="0.08 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="link_6"><visual><origin xyz="0.04 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.025" length="0.08"/></geometry><material name="joint"/></visual></link>
  <joint name="joint_6" type="continuous"><parent link="link_5"/><child link="link_6"/><origin xyz="0.06 0 0"/><axis xyz="1 0 0"/></joint>
  <link name="tool0"/>
  <joint name="tool_fixed" type="fixed"><parent link="link_6"/><child link="tool0"/><origin xyz="0.08 0 0"/></joint>
</robot>
