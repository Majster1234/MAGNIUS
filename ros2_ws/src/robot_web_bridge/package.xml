<?xml version="1.0"?>
<package format="3">
  <name>robot_web_bridge</name>
  <version>0.0.0</version>
  <description>Diagnostyka robota i lokalny panel ROS 2.</description>
  <maintainer email="maintainer@example.com">Project maintainer (TODO)</maintainer>
  <license>TODO</license>
  <exec_depend>rclpy</exec_depend>
